#! /bin/bash

START_TIME=$SECONDS
options=$@
arguments=($options)

#default options
threads=8
mem=8
outdir="StrainR_abundances"
prefix="sample"
weighted_percentile=60
subcontig_filter=0


#parse options
i=0
for argument in $options
  do
    i=$(( $i + 1 ))

    case $argument in
      -1 | --forward) forward="${arguments[i]}" ;;
      -2 | --reverse) reverse="${arguments[i]}" ;;
      -r | --reference) reference="${arguments[i]}" ;;
      -c | --weightedpercentile) weighted_percentile="${arguments[i]}" ;;
      -s | --subcontigfilter) subcontig_filter="${arguments[i]}" ;;
      -t | --threads) threads="${arguments[i]}" ;;
      -m | --mem) mem="${arguments[i]}" ;;
      -b1 | --background1) background1="${arguments[i]}" ;;
      -b2 | --background2) background2="${arguments[i]}" ;;
      -o | --outdir) outdir="${arguments[i]}" ;;
      -p | --prefix) prefix="${arguments[i]}" ;;
      -h | --help) 
              printf "USAGE: StrainR -1 path/to/forward.fastq.gz -2 path/to/reverse.fastq.gz -r path/to/reference/directory [OPTIONS]\n\
StrainR normalizes mapping from reads using the output from PreProcessR\n\
\tRequired Arguments:\n\
\t\t-1/--forward path/to/forward.fastq.gz\t\t: path to forward reads\n\
\t\t-r/--reference path/to/reference/directory\t: path to the output directory generated by PreProcessR\n\
\tOptional Arguments:\n\
\t\t-2/--reverse path/to/reverse.fastq.gz\t\t: path to reverse reads\n\
\t\t-c/--weightedpercentile number\t: Weighted percentile for a strain's FUKMs to use in abundance estimation [Default = 60]\n\
\t\t-s/--subcontigfilter number\t: Percentage of a strain's subcontigs that should be filtered out based on number of unique k-mers [Default = 0]\n\
\t\t-b1/--background1 path/to/background1.fq.gz\t: path to forward background reads for exclusion. This is not necessary in a typical use case. [Default = None]\n\
\t\t-b2/--background2 path/to/background2.fq.gz\t: path to reverse background reads for exclusion. This is not necessary in a typical use case. [Default = None]\n\
\t\t-o/--outdir path/to/out\t\t: path to your output directory to contain normalized abundances [Default = current directory]\n\
\t\t-p/--prefix string\t\t: Name of community (used in output files) [Default = "sample"]\n\
\t\t-t/--threads number\t\t: number of threads to use when running fastp, bbmap, and samtools. Maximum is 16 [Default = 8]\n\
\t\t-m/--mem number\t\t\t: gigabytes of memory to use when running bbmap [Default = 8]\n\
\t\t-h/--help\t\t\t: Display this message\n"
            exit
            ;;
    esac
  done

if [ -z "$reference" ]; then
  echo "Error: Reference directory needs to be provided with -r or --reference. Use 'StrainR --help' for more info."
  exit
fi
if [ ! -d "$reference" ]; then
  echo "Error: Reference directory doesn't exist."
  exit
fi
if ! [ -f "$reference"/options.txt ]; then
  echo "Error: Reference directory doesn't have options file. You may be using a reference generated by an old version of PreProcessR."
  exit
fi

if [[ $(grep 'singleend' "$reference"/options.txt | sed 's/.*\t//') == "TRUE" ]]; then
  singleends=true;
else
  singleends=false;
fi
if [ -z "$forward" ]; then
  echo "Error: Forward reads need to be provided with -1 or --forward. Use 'StrainR --help' for more info."
  exit
fi
if [ -z "$reverse" ]; then
  echo "WARNING: You did not provide reverse reads with -2 or --reverse. StrainR2 will now be running in single end read mode Use 'StrainR --help' for more info."
  if [[ $singleends == false ]]; then
    echo "Error: PreProcessR was not run with single ends enabled. Please regenerate the reference directory using the --singleend option or provide paired end reads."
    exit
  fi
else
  if [[ $singleends == true ]]; then
    echo "Error: PreProcessR was run with single ends enabled. Please regenerate the reference directory without using the --singleend option or provide single end reads."
    exit
  fi
fi
if [ -d "$outdir" ]; then
  echo "Error: Output directory already exists."
  exit
fi

if ! mkdir "$outdir"; then
  echo "Error: failed to create outdir. Exiting."
  exit
fi
mkdir "$outdir"/tmp

#trim reads
echo Trimming Reads
if [[ $singleends == false ]]; then
  fastp -i "$forward" -o "$outdir"/tmp/forward.fastq.gz \
    -I "$reverse" -O "$outdir"/tmp/reverse.fastq.gz \
    --trim_poly_g --json "$outdir" --html "$outdir" \
    --length_required 50 --n_base_limit 0 \
    --thread "$threads"
else
  fastp -i "$forward" -o "$outdir"/tmp/forward.fastq.gz \
    --trim_poly_g --json "$outdir" --html "$outdir" \
    --length_required 50 --n_base_limit 0 \
    --thread "$threads"
fi

#map reads
echo Mapping Reads
if [[ $singleends == false ]]; then
  bbmap.sh\
    in="$outdir"/tmp/forward.fastq.gz in2="$outdir"/tmp/reverse.fastq.gz \
    ref="$reference"/BBindex/BBIndex.fasta \
    outm="$outdir"/"$prefix".sam \
    rpkm="$outdir"/"$prefix".rpkm \
    threads="$threads" deterministic=t averagepairdist=200 \
    -Xmx"$mem"g \
    perfectmode=t local=f ambiguous=toss pairedonly=t nodisk=t
else
  bbmap.sh\
    in="$outdir"/tmp/forward.fastq.gz \
    ref="$reference"/BBindex/BBIndex.fasta \
    outm="$outdir"/"$prefix".sam \
    rpkm="$outdir"/"$prefix".rpkm \
    threads="$threads" deterministic=t \
    -Xmx"$mem"g \
    perfectmode=t local=f ambiguous=toss nodisk=t
fi

samtools view --threads "$threads" -bS "$outdir"/"$prefix".sam | \
samtools sort --threads "$threads" -o "$outdir"/"$prefix".bam

# background subtraction if background provided
if [ ! -z "$background1" ]; then
  background_single = true
  if [ ! -z "$background2" ]; then
    background_single = false
  fi
  #trim background reads
  echo Trimming Background Reads
  if [[ $background_single == false ]]; then
    fastp -i "$background1" -o "$outdir"/tmp/bg_forward.fastq.gz \
      -I "$background2" -O "$outdir"/tmp/bg_reverse.fastq.gz \
      --trim_poly_g --json "$outdir" --html "$outdir" \
      --length_required 50 --n_base_limit 0 \
      --thread "$threads"
  else
    fastp -i "$background1" -o "$outdir"/tmp/bg_forward.fastq.gz \
      --trim_poly_g --json "$outdir" --html "$outdir" \
      --length_required 50 --n_base_limit 0 \
      --thread "$threads"
  fi

  #map background reads
  echo Mapping Background Reads
  if [[ $background_single == false ]]; then
    bbmap.sh\
      in="$outdir"/tmp/bg_forward.fastq.gz in2="$outdir"/tmp/bg_reverse.fastq.gz \
      ref="$reference"/BBindex/BBIndex.fasta \
      outm="$outdir"/"$prefix"_bg.sam \
      rpkm="$outdir"/"$prefix"_bg.rpkm \
      threads="$threads" deterministic=t averagepairdist=200 \
      -Xmx"$mem"g \
      perfectmode=t local=f ambiguous=toss pairedonly=t nodisk=t
  else
    bbmap.sh\
      in="$outdir"/tmp/bg_forward.fastq.gz \
      ref="$reference"/BBindex/BBIndex.fasta \
      outm="$outdir"/"$prefix"_bg.sam \
      rpkm="$outdir"/"$prefix"_bg.rpkm \
      threads="$threads" deterministic=t \
      -Xmx"$mem"g \
      perfectmode=t local=f ambiguous=toss nodisk=t
  fi

  rm "$outdir"/"$prefix"_bg.rpkm

  samtools view --threads "$threads" -bS "$outdir"/"$prefix"_bg.sam | \
  samtools sort --threads "$threads" -o "$outdir"/"$prefix"_bg.bam

  rm "$outdir"/"$prefix"_bg.sam

  echo Filtering Background Reads from Sample Reads
  samtools view -H "$outdir"/"$prefix".bam | grep '^@SQ' | sed -E 's/@SQ\tSN://;s/\tLN:/\t/' > "$outdir"/genome_file.txt

  bedtools subtract -s -sorted -A -f 0.97 \
    -g "$outdir"/genome_file.txt \
    -a "$outdir"/"$prefix".bam \
    -b "$outdir"/"$prefix"_bg.bam \
    > "$outdir"/"$prefix"_filtered.bam

  samtools sort --threads "$threads" -n "$outdir"/"$prefix"_filtered.bam \
    -o "$outdir"/"$prefix"_filtered_sorted.bam
  
  rm "$outdir"/"$prefix"_filtered.bam
  
  if [[ $singleends == false ]]; then
    samtools fastq -1 "$outdir"/"$prefix"_filtered_1.fq \
      -2 "$outdir"/"$prefix"_filtered_2.fq \
      -0 /dev/null -s /dev/null -n --threads "$threads" \
      "$outdir"/"$prefix"_filtered_sorted.bam
  else
    samtools fastq -1 "$outdir"/"$prefix"_filtered_1.fq \
      -0 /dev/null -s /dev/null -n --threads "$threads" \
      "$outdir"/"$prefix"_filtered_sorted.bam
  fi

  if [[ $singleends == false ]]; then
    bbmap.sh \
      in="$outdir"/"$prefix"_filtered_1.fq \
      in2="$outdir"/"$prefix"_filtered_2.fq \
      ref="$reference"/BBindex/BBIndex.fasta \
      outm="$outdir"/filtered_"$prefix"_remap.sam \
      rpkm="$outdir"/filtered_"$prefix"_remap.rpkm \
      threads="$threads" deterministic=t averagepairdist=200 \
      -Xmx"$mem"g perfectmode=t local=f ambiguous=toss pairedonly=t nodisk=t
  else
    bbmap.sh \
      in="$outdir"/"$prefix"_filtered_1.fq \
      ref="$reference"/BBindex/BBIndex.fasta \
      outm="$outdir"/filtered_"$prefix"_remap.sam \
      rpkm="$outdir"/filtered_"$prefix"_remap.rpkm \
      threads="$threads" deterministic=t \
      -Xmx"$mem"g perfectmode=t local=f ambiguous=toss nodisk=t
  fi

  rm "$outdir"/"$prefix"_filtered_1.fq
  rm "$outdir"/"$prefix"_filtered_2.fq
  rm "$outdir"/"$prefix"_filtered_sorted.bam
  rm "$outdir"/filtered_"$prefix"_remap.sam
  rm "$outdir"/genome_file.txt
fi

rm "$outdir"/"$prefix".sam
rm -r "$outdir"/tmp

echo "Plotting normalized data"
if Plot.R -a "$outdir" -i "$reference" -p "$prefix" -c "$weighted_percentile" -s "$subcontig_filter"; then
  echo "StrainR complete"
  echo "Total Run Time: $((($SECONDS - $START_TIME)/60)) min $((($SECONDS - $START_TIME)%60)) sec"
  exit
fi
echo "Error: Failed to generate output files, exiting"
exit
